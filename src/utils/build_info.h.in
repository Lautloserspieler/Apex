#define APEX_BUILD_GIT_REVISION "@APEX_GIT_REVISION@"
#define APEX_BUILD_LLAMA_CPP_REVISION "@APEX_LLAMA_CPP_REVISION@"
#define APEX_BUILD_TYPE "@APEX_BUILD_TYPE_NAME@"
#define APEX_BUILD_COMPILER "@CMAKE_CXX_COMPILER_ID@ @CMAKE_CXX_COMPILER_VERSION@"
#define APEX_BUILD_SYSTEM "@CMAKE_SYSTEM_NAME@ @CMAKE_SYSTEM_PROCESSOR@"
#define APEX_BUILD_CUDA_GRAPHS @APEX_CUDA_GRAPHS_FLAG@
